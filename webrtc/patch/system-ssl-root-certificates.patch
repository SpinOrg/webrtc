+bool AddCertificateToStore(X509_STORE* store,
+                           const unsigned char* der,
+                           size_t der_length) {
+  const unsigned char* cursor = der;
+  X509* certificate =
+      d2i_X509(nullptr, &cursor, checked_cast<long>(der_length));  // NOLINT
+  if (certificate == nullptr) {
+    ERR_clear_error();
+    return false;
+  }
+  const bool added = X509_STORE_add_cert(store, certificate) == 1;
+  X509_free(certificate);
+  if (!added) {
+    ERR_clear_error();
+  }
+  return added;
+}
+#endif
 }  // namespace
 
