+#ifdef WEBRTC_USE_SYSTEM_SSL_ROOT_CERTIFICATES
+bool LoadSystemSSLRootCertificates(SSL_CTX* ctx) {
+  if (ctx == nullptr) {
+    return false;
+  }
+
+#if defined(WEBRTC_WIN)
+  X509_STORE* target = SSL_CTX_get_cert_store(ctx);
+  int added = 0;
+  const DWORD locations[] = {
+      CERT_SYSTEM_STORE_CURRENT_USER,
+      CERT_SYSTEM_STORE_LOCAL_MACHINE,
+  };
+  for (DWORD location : locations) {
+    HCERTSTORE system_store = CertOpenStore(
+        CERT_STORE_PROV_SYSTEM_A, 0, 0,
+        location | CERT_STORE_READONLY_FLAG, "ROOT");
+    if (system_store == nullptr) {
+      RTC_LOG(LS_WARNING) << "Unable to open a Windows ROOT certificate store: "
+                          << GetLastError();
+      continue;
+    }
+
+    PCCERT_CONTEXT certificate = nullptr;
+    while ((certificate =
+                CertEnumCertificatesInStore(system_store, certificate)) !=
+           nullptr) {
+      if (AddCertificateToStore(target, certificate->pbCertEncoded,
+                                certificate->cbCertEncoded)) {
+        ++added;
+      }
+    }
+    CertCloseStore(system_store, 0);
+  }
+  RTC_LOG(LS_INFO) << "Loaded " << added
+                   << " TLS root certificates from Windows certificate stores";
+  return added > 0;
+
+#elif defined(WEBRTC_MAC) && !defined(WEBRTC_IOS)
+  CFArrayRef anchors = nullptr;
+  if (SecTrustCopyAnchorCertificates(&anchors) != errSecSuccess ||
+      anchors == nullptr) {
+    RTC_LOG(LS_WARNING) << "Unable to read macOS trust anchors";
+    return false;
+  }
+
+  X509_STORE* target = SSL_CTX_get_cert_store(ctx);
+  int added = 0;
+  const CFIndex count = CFArrayGetCount(anchors);
+  for (CFIndex index = 0; index < count; ++index) {
+    SecCertificateRef certificate = static_cast<SecCertificateRef>(
+        const_cast<void*>(CFArrayGetValueAtIndex(anchors, index)));
+    CFDataRef der = SecCertificateCopyData(certificate);
+    if (der == nullptr) {
+      continue;
+    }
+    const CFIndex der_length = CFDataGetLength(der);
+    if (der_length > 0 &&
+        AddCertificateToStore(target, CFDataGetBytePtr(der),
+                              checked_cast<size_t>(der_length))) {
+      ++added;
+    }
+    CFRelease(der);
+  }
+  CFRelease(anchors);
+  RTC_LOG(LS_INFO) << "Loaded " << added
+                   << " TLS root certificates from macOS Security anchors";
+  return added > 0;
+
+#elif defined(WEBRTC_POSIX)
+  const bool loaded = SSL_CTX_set_default_verify_paths(ctx) == 1;
+  if (!loaded) {
+    RTC_LOG(LS_WARNING) << "Unable to load the system TLS root paths";
+    LogSSLErrors("Loading system TLS root paths");
+  }
+  return loaded;
+
+#else
+  RTC_LOG(LS_ERROR) << "System TLS root loading is unsupported on this platform";
+  return false;
+#endif
+}
+#endif  // WEBRTC_USE_SYSTEM_SSL_ROOT_CERTIFICATES
+
